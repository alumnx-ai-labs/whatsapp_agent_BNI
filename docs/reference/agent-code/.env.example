# --- Anthropic (reasoning agents) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- WhatsApp provider selection: "twilio" | "meta" | "console" (console = local testing, no real WhatsApp) ---
WHATSAPP_PROVIDER=console

# --- Twilio (if WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta WhatsApp Cloud API (if WHATSAPP_PROVIDER=meta) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=change-me

# --- Server ---
PORT=3000

# --- Calendar (stubbed by default; swap in Google Calendar API creds when ready) ---
CALENDAR_PROVIDER=stub
